{
  "manifest_version": 3,
  "name": "Spaces Float Player",
  "version": "1.4.0",
  "minimum_chrome_version": "111",
  "description": "Плавающий музыкальный плеер с прозрачным Liquid Glass и мини-плеером Dynamic Island.",
  "content_scripts": [
    {
      "matches": [
        "*://*.spcs.me/*",
        "*://*.spcs.bio/*",
        "*://*.spaces.ru/*",
        "*://*.spaces.me/*",
        "*://*.spaces.im/*"
      ],
      "js": [
        "float-player.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
